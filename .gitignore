# Secrets — never commit
.env
.env.*
# The template ships as env.example, without the leading dot, so it is
# not matched by the patterns above and needs no negation. If you ever
# rename it to .env.example, restore `!.env.example` here or it vanishes
# from the repo silently.
service-account.json
*.pem
*.key

# Real client data — never commit
data/
out/
private/
*.db
*.sqlite
*.sqlite3

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Tooling scratch
.playwright-mcp/

# OS / editor
.DS_Store
.idea/
.vscode/
