# Copy to .env and fill in. .env is gitignored; keep it that way.
#
# Load order is ./.env, then $ANGLE_ENV_FILE, then the real environment.
# The real environment always wins, so any single value can be overridden
# inline without editing a file:
#
#     ANGLE_LOOKBACK_DAYS=90 python run.py --account bty pull

# ------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Bulk claim extraction and clustering. This is the only stage that costs
# real money, so it is the one worth changing if spend matters — but change
# it deliberately and compare the output, rather than assuming.
ANGLE_MODEL=claude-opus-5

# Brief writing. Runs over a handful of angles; this is the judgment layer
# being sold. Defaults to ANGLE_MODEL when unset.
ANGLE_BRIEF_MODEL=

# ------------------------------------------------------------------
# Meta — Page and Instagram
# ------------------------------------------------------------------
# Long-lived PAGE token, not a user token. Needs: pages_read_engagement,
# pages_show_list, read_insights, instagram_basic, instagram_manage_insights.
META_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_API_VERSION=v23.0

# OAuth app, for onboarding clients rather than running on your own Page.
META_APP_ID=
META_APP_SECRET=

# ------------------------------------------------------------------
# Google — Search Console and GA4
# ------------------------------------------------------------------
# Service account, for properties you own. One account covers both APIs.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Domain property: sc-domain:example.com (no protocol, no trailing slash).
# URL-prefix property: the exact prefix, protocol and trailing slash included.
# A mismatch here returns EMPTY RESULTS, not an error. Run `doctor` first.
GSC_SITE_URL=

# The numeric property ID from GA4 Admin -> Property details.
# Not the G-XXXXXXX measurement ID.
GA4_PROPERTY_ID=

# OAuth app, for onboarding clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# First-party sources
# ------------------------------------------------------------------
# Defaults to ./data/transcripts. Drop .txt, .vtt, .srt or .json in there.
ANGLE_TRANSCRIPT_DIR=

# Email export with subject lines and open rates.
ANGLE_EMAIL_CSV=

TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=

# ------------------------------------------------------------------
# Pull window and caps
# ------------------------------------------------------------------
ANGLE_LOOKBACK_DAYS=540
ANGLE_MAX_POSTS=500
ANGLE_MAX_COMMENTS_PER_POST=200

# ------------------------------------------------------------------
# Local
# ------------------------------------------------------------------
ANGLE_DB=./angle.db
ANGLE_OUT_DIR=./out

# Onboarding server. Must be a real https URL in production — neither
# Meta nor Google will redirect to a non-local http address.
ANGLE_BASE_URL=http://localhost:5000
